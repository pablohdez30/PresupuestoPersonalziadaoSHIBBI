# =============================================================
# Variables de entorno
#
# Copia este archivo a `.env.local` y rellena con tus claves
# reales. `.env.local` está en .gitignore — nunca lo subas.
# =============================================================

# --- Supabase --------------------------------------------------
# 1. Crea un proyecto gratuito en https://supabase.com
# 2. Project Settings → API → copia URL y anon/public key
# 3. Project Settings → API → reveal service_role key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# --- Resend (envío de emails) ---------------------------------
# Plan gratis: https://resend.com — 3.000 emails/mes
# Hasta verificar dominio puedes usar onboarding@resend.dev como FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Shibbi <hola@shibbishop.com>
SHIBBI_NOTIFICATION_EMAIL=shibbishop@gmail.com
